{
  "name": "iptv-webos",
  "private": true,
  "description": "Xtream Codes IPTV player for LG webOS TVs (sideloaded)",
  "scripts": {
    "dev": "node dev/mock-server.js",
    "icons": "node dev/make-icons.js",
    "package": "ares-package app -o dist",
    "install-tv": "ares-install -d tv dist/com.homebrew.iptvplayer_1.0.0_all.ipk",
    "launch": "ares-launch -d tv com.homebrew.iptvplayer",
    "inspect": "ares-inspect -d tv --app com.homebrew.iptvplayer --open"
  }
}
